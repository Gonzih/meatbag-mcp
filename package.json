{
  "name": "@gonzih/meatbag-mcp",
  "version": "1.1.1",
  "description": "Human-in-the-loop MCP for Claude Code: central Telegram service + thin MCP clients. Multiple agents share one human channel without routing conflicts.",
  "main": "dist/mcp.js",
  "bin": {
    "meatbag-mcp": "dist/mcp.js",
    "meatbag-service": "dist/service.js"
  },
  "scripts": {
    "build": "tsc",
    "dev:mcp": "ts-node src/mcp.ts",
    "dev:service": "ts-node src/service.ts",
    "test": "jest --forceExit"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/src/__tests__/**/*.test.ts"],
    "collectCoverage": true,
    "coverageProvider": "v8",
    "collectCoverageFrom": ["src/**/*.ts", "!src/__tests__/**"],
    "coverageReporters": ["text", "text-summary", "json-summary"]
  },
  "keywords": [
    "mcp",
    "telegram",
    "human-in-the-loop",
    "claude",
    "ai-agent"
  ],
  "author": "gonzih",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "22.15.21",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
